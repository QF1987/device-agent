# DeviceOps device-agent bootstrap answer file.
# Copy to device-agent.answer beside install-device-agent.cmd, or pass -AnswerFile.

server_host=deviceops.example.com
server_port=9090
use_tls=true

# --- Identity: pick ONE of the two ---
# (A) Self-enroll (recommended). One installer key is shared per batch; the
#     device derives its own device_id/token on first start and shows as
#     "pending" in the dashboard until an operator approves it.
#     Leave device_id/token empty in this mode.
installer_key_id=
installer_key=

# (B) Static credentials (legacy / optional). Only used when no installer_key
#     is set. Leave empty when self-enrolling.
device_id=
token=

# Optional. Absolute paths where the device persists its enrolled credential
# and short-code status. Leave empty to use %PROGRAMDATA%\DeviceOps defaults.
enrollment_token_file=
enrollment_status_file=

# --- Package source: local/offline takes priority, online is the fallback ---
# Offline: drop device-agent.exe (or a *.zip) beside install-device-agent.cmd
# and leave local_package empty — the script auto-detects it. Or point
# local_package at a specific file (relative to the cmd, or absolute).
local_package=
# Online: only needed when there is no local package. agent_sha256 is required
# for downloads; for a local package it is an optional integrity check.
agent_url=
agent_sha256=

# Optional. If omitted, the script uses ProgramFiles\DeviceOps\device-agent.
install_dir=
service_name=DeviceAgent
log_dir=

# Optional prerequisites. URL mode requires a matching sha256. When the kit
# contains prerequisites/vc_redist.x64.exe, the installer discovers it and
# reads its hash from SHA256SUMS.txt; these fields may remain empty.
vc_redist_url=
vc_redist_sha256=
ucrt_url=
ucrt_sha256=

# Optional install result callback. Leave empty unless an existing endpoint is available.
bootstrap_report_url=
