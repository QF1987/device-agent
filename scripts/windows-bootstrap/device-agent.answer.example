# DeviceOps device-agent bootstrap answer file.
# Copy to device-agent.answer beside install-device-agent.cmd, or pass -AnswerFile.

server_host=deviceops.example.com
server_port=9090
use_tls=true

device_id=DEV-WIN-001
token=replace-with-device-token

agent_url=https://deviceops.example.com/api/v1/files/<file_id>/download
agent_sha256=replace-with-package-sha256

# Optional. If omitted, the script uses ProgramFiles\DeviceOps\device-agent.
install_dir=
service_name=DeviceAgent
log_dir=

# Optional prerequisites. Provide fixed first-party URLs and sha256 values.
vc_redist_url=
vc_redist_sha256=
ucrt_url=
ucrt_sha256=

# Optional install result callback. Leave empty unless an existing endpoint is available.
bootstrap_report_url=
